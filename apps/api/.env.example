# Required at boot — see apps/api/src/config/env.validation.ts. The process
# refuses to start when any of these is missing (FRONTEND_URL only in prod).
PORT=3001
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
FRONTEND_URL=http://localhost:3000

# Sentry (optional). Without a DSN, instrument.ts is a no-op.
# All events pass through the scrubber in src/common/sentry-scrub.ts (BH-17).
SENTRY_DSN=

# Azure AI Document Intelligence (OCR)
AZURE_DOC_INTELLIGENCE_ENDPOINT=your_azure_doc_intelligence_endpoint
AZURE_DOC_INTELLIGENCE_KEY=your_azure_doc_intelligence_key

# Stripe (BRC certificate payments)
# STRIPE_SECRET_KEY: server-side API key (sk_test_… / sk_live_…). Without it
#   the payments module still boots but checkout returns 503 and the web UI
#   degrades the pay button.
# STRIPE_WEBHOOK_SECRET: endpoint signing secret (whsec_…) used to verify the
#   Stripe-Signature header. Required for /api/v1/payments/stripe/webhook.
# STRIPE_PUBLISHABLE_KEY: public key; optional on the API, kept for parity.
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
