# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only (NEVER prefix with NEXT_PUBLIC_ — it would ship in the bundle).
# Required by /api/verify/[id]; without it every BRC certificate reports
# NO_ENCONTRADO. See docs/SECURITY.md BH-02.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# HMAC key that signs the public certificate-verification response.
# Generate with: openssl rand -hex 32
# There is NO default: the app refuses to sign without it.
BRC_VERIFY_SECRET=generate-with-openssl-rand-hex-32

# API Backend
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Destination of the /api/v1/* rewrite. Validated against an allowlist
# (src/lib/api-rewrite-target.ts) to bound the Next SSRF in rewrites (BH-08).
API_URL=http://localhost:3001
# Optional: extra hosts allowed as rewrite destinations, comma-separated.
# API_REWRITE_ALLOWED_HOSTS=

# Sentry (optional). Without a DSN Sentry is a no-op.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=

# Rate limiting: how many proxies sit in front of this process. 1 = Azure App
# Service only; 2 = behind Azure Front Door. Used to pick the trustworthy
# entry of X-Forwarded-For (BH-10).
# RATE_LIMIT_PROXY_DEPTH=1

# Stripe (BRC certificate payments)
# When this key is absent the BRC pay button degrades to a disabled state with
# a "contáctanos" message instead of opening a checkout that cannot exist.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
